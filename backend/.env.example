# ========================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Application Port (automatically assigned by Render/Railway in production)
PORT=5000

# Production Frontend URL for CORS (e.g. your Vercel deployment)
FRONTEND_URL=https://student-details-portal.vercel.app

# ========================================================
# MYSQL DATABASE CONFIGURATION
# For Local Development: Use localhost, root, and your local password
# For Production: Use connection details from your Cloud MySQL provider
# (e.g. TiDB Cloud Serverless, Aiven, Railway, AWS RDS, PlanetScale)
# ========================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_portal

# Set DB_SSL=true when connecting to cloud MySQL providers that require SSL
DB_SSL=false
